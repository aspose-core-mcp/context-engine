# =============================================================================
# .env.example — placeholder values only.
# =============================================================================
# This file is committed to git as a template. It MUST contain only safe
# placeholders (e.g. `replace-me`, empty strings, localhost defaults).
# Real credentials are provided via:
#   - .env.local (gitignored, see .gitignore)
#   - Kubernetes Secret env (see infra/helm/adcs/templates/secret-env.yaml)
#   - CI/CD secret managers
# See docs/secrets-handling.md for the full rotation and handling policy.
# =============================================================================

# Core
ADCS_ENV=dev
ADCS_LOG_LEVEL=info

# API
ADCS_HOST=0.0.0.0
ADCS_PORT=8080
ADCS_API_KEY=replace-me
ADCS_ADMIN_KEYS_SOURCE=env
ADCS_ADMIN_KEYS_JSON_PATH=./config/admin_keys.json
ADCS_ADMIN_SESSION_COOKIE_NAME=adcs_admin_session
ADCS_ADMIN_SESSION_TTL_SECONDS=2592000
ADCS_ADMIN_SESSION_REMEMBER_TTL_SECONDS=15552000
ADCS_ADMIN_SESSION_COOKIE_SECURE=false
ADCS_ADMIN_SESSION_COOKIE_SAMESITE=lax

# Data sources
ADCS_APIDOCS_ROOT=./data-apiref
ADCS_DOCS_ROOT=./data-docs

# Services
POSTGRES_DSN=postgresql+psycopg://adcs:adcs@localhost:5432/adcs
REDIS_URL=redis://localhost:6379/0
# DEV-ONLY localhost default. RabbitMQ's built-in guest/guest is usable only
# from localhost (loopback_users=guest); it is NOT a deployable credential.
# Prod/k8s supplies RABBITMQ_URL from a Secret — see docs/secrets-handling.md.
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
ADCS_PERSISTENCE_BACKEND=auto
ADCS_RETRIEVAL_BACKEND=auto
ADCS_TEST_MODE=false

# Retrieval tuning
ADCS_HYBRID_DENSE_WEIGHT=0.55
ADCS_HYBRID_LEXICAL_WEIGHT=0.45
ADCS_HYBRID_LANE_TIMEOUT_SECONDS=10.0
ADCS_ENDPOINT_TIMEOUT_SECONDS=30.0

# Feature flags
# Swagger UI (/docs) and ReDoc (/redoc) load their assets from cdn.jsdelivr.net and Google Fonts.
ADCS_API_DOCS_ENABLED=false
ADCS_WEBMCP_ENABLED=false
ADCS_WEBMCP_CONFIRM_TTL_SECONDS=300
ADCS_MCP_SUPPORTED_REVISIONS=2025-11-25,2025-06-18,2024-11-05
ADCS_ABUSE_GUARD_MODE=observe-only
ADCS_ABUSE_GUARD_ALLOWLIST=
ADCS_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADCS_ABUSE_REQUESTS_PER_IP_PER_MINUTE=120
ADCS_ABUSE_REQUESTS_PER_FINGERPRINT_PER_MINUTE=180
ADCS_ABUSE_REQUESTS_GLOBAL_PER_MINUTE=5000
ADCS_INGESTION_PARTIAL_PUBLISH_THRESHOLD_PCT=30
ADCS_INGESTION_PUBLISH_SAFETY_MIN_COVERAGE_PCT=50
ADCS_INGESTION_METADATA_QUARANTINE_POLICY=best_effort_continue
ADCS_INGESTION_RETRY_MAX_ATTEMPTS=5
ADCS_INGESTION_RETRY_BACKOFF_BASE_SECONDS=5
ADCS_INGESTION_RETRY_BACKOFF_MAX_SECONDS=120
ADCS_TRANSLATION_LLM_CONFIG_PATH=./config/translation_llm.json
ADCS_INGESTION_LLM_POLICY_CONFIG_PATH=./config/ingestion_llm_policy.json
ADCS_INGESTION_PROMPT_REGISTRY_CONFIG_PATH=./config/ingestion_prompt_registry.json
ADCS_LAYOUT_DETECTION_CONFIDENCE_THRESHOLD=0.80
ADCS_LAYOUT_DETECTION_ALLOW_MANUAL_OVERRIDE=true
ADCS_QUALITY_GATES_PHASE=mvp
ADCS_TRANSLATION_LLM_API_KEY=
ADCS_INGESTION_LLM_API_KEY=

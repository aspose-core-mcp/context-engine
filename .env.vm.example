# Copy to .env.vm; generate separate values with: openssl rand -hex 32
# Use URL-safe hex passwords because Compose places them in connection URLs.
ADCS_API_KEY=
ADCS_HASH_SECRET=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# A reachable OpenAI-compatible /v1 base URL and its embedding model.
# localhost refers to the container, not the VM. Keep model fixed after ingestion.
ADCS_EMBEDDING_API_URL=
ADCS_EMBEDDING_API_KEY=
ADCS_EMBEDDING_MODEL=

# Starting limits, not measured capacity requirements. Adjust for the VM/corpus.
ADCS_WORKER_MEM_LIMIT=24g
ADCS_API_MEM_LIMIT=4g
ADCS_API_PORT=8080
ADCS_API_BIND_ADDRESS=127.0.0.1

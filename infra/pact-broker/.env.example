# Local Pact Broker credentials — DEV-ONLY.
#
# `make pact-broker-up` copies this file to infra/pact-broker/.env (gitignored)
# on first run, so the broker starts with zero manual setup. Override any value
# in your local .env; never commit real credentials.
#
# docker-compose.yml requires these variables and has no defaults of its own.
PACT_BROKER_PG_PASSWORD=pactbroker-pg-local
PACT_BROKER_BASIC_AUTH_PASSWORD=pactbroker
PACT_BROKER_BASIC_AUTH_READ_ONLY_PASSWORD=pactread

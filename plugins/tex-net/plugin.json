      "path": "source-repo-apiref/Aspose.TeX",
      "prefix": "english/net",
      "layout": {
        "layout_type": "doc_locale/programming_language/namespace"
      },
      "canonical_base_url": "https://reference.aspose.com/tex",
      "url": "https://github.com/aspose-tex/Aspose.TeX-API-References.git",

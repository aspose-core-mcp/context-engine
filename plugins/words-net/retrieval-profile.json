{
  "schema_version": 1,
  "profile_id": "aspose.words.net.retrieval",
  "version": "1.2.0",
  "product_id": "aspose.words",
  "language": "net",
  "rules": [
    {
      "rule_id": "classic-mail-merge",
      "all_terms": [
        "mail",
        "merge"
      ],
      "exclude_terms": [
        "region",
        "regions",
        "image",
        "images",
        "lowcode",
        "low code"
      ],
      "preferred_symbols": [
        "Aspose.Words.MailMerging.MailMerge.Execute"
      ]
    },
    {
      "rule_id": "classic-mail-merge-regions",
      "all_terms": [
        "mail",
        "merge",
        "regions"
      ],
      "exclude_terms": [
        "image",
        "images",
        "lowcode",
        "low code"
      ],
      "preferred_symbols": [
        "Aspose.Words.MailMerging.MailMerge.ExecuteWithRegions"
      ]
    },
    {
      "rule_id": "word-to-pdf",
      "all_terms": [
        "pdf"
      ],
      "any_terms": [
        "doc",
        "docx",
        "word",
        "document"
      ],
      "any_phrases": [
        "to pdf",
        "as pdf"
      ],
      "exclude_terms": [],
      "preferred_symbols": [
        "Aspose.Words.Document.Save",
        "Aspose.Words.Saving.PdfSaveOptions"
      ]
    }
  ],
  "excluded_namespaces": [
    "Aspose.Words.Lowcode"
  ]
}

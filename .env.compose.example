# Compose-local runtime profile (safe defaults only)
ADCS_ENV=dev
ADCS_LOG_LEVEL=info

ADCS_HOST=0.0.0.0
ADCS_PORT=8080
ADCS_API_KEY=replace-me-local
ADCS_ADMIN_KEYS_SOURCE=env
ADCS_ADMIN_KEYS_JSON_PATH=./config/admin_keys.json

# Local compose database. Replace `replace-me-local` with a per-host password
# before running `docker compose up`. The example values are placeholders only;
# do not deploy this file as-is. See docs/secrets-handling.md.
POSTGRES_DB=adcs
POSTGRES_USER=adcs
POSTGRES_PASSWORD=replace-me-local
POSTGRES_DSN=postgresql+psycopg://adcs:replace-me-local@postgres:5432/adcs
REDIS_URL=redis://redis:6379/0
# DEV-ONLY compose default. The local rabbitmq container runs with the built-in
# guest account (usable only inside the compose network); NOT a deployable
# credential. Prod/k8s supplies RABBITMQ_URL from a Secret (secrets-handling.md).
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
QDRANT_URL=http://qdrant:6333
OPENSEARCH_URL=http://opensearch:9200
ADCS_PERSISTENCE_BACKEND=postgres
ADCS_RETRIEVAL_BACKEND=qdrant_opensearch
ADCS_TEST_MODE=false

ADCS_WEBMCP_ENABLED=false
ADCS_WEBMCP_CONFIRM_TTL_SECONDS=300
ADCS_MCP_SUPPORTED_REVISIONS=2025-11-25,2025-06-18,2024-11-05
ADCS_ABUSE_GUARD_MODE=observe-only
ADCS_ABUSE_GUARD_ALLOWLIST=
ADCS_ABUSE_REQUESTS_PER_IP_PER_MINUTE=120
ADCS_ABUSE_REQUESTS_PER_FINGERPRINT_PER_MINUTE=180
ADCS_ABUSE_REQUESTS_GLOBAL_PER_MINUTE=5000
ADCS_INGESTION_PARTIAL_PUBLISH_THRESHOLD_PCT=30
ADCS_INGESTION_METADATA_QUARANTINE_POLICY=best_effort_continue
ADCS_INGESTION_RETRY_MAX_ATTEMPTS=5
ADCS_INGESTION_RETRY_BACKOFF_BASE_SECONDS=5
ADCS_INGESTION_RETRY_BACKOFF_MAX_SECONDS=120
ADCS_TRANSLATION_LLM_CONFIG_PATH=./config/translation_llm.json
ADCS_INGESTION_LLM_POLICY_CONFIG_PATH=./config/ingestion_llm_policy.json
ADCS_INGESTION_PROMPT_REGISTRY_CONFIG_PATH=./config/ingestion_prompt_registry.json
ADCS_LAYOUT_DETECTION_CONFIDENCE_THRESHOLD=0.80
ADCS_LAYOUT_DETECTION_ALLOW_MANUAL_OVERRIDE=true
ADCS_QUALITY_GATES_PHASE=mvp

# Lightweight Dockerfile for k8s deployment (no source-repo-* dirs)
# Data is served from Qdrant/OpenSearch indexes, not from filesystem.
#
# Build targets:
#   docker build -f Dockerfile.k8s --target api -t adcs-api .
#   docker build -f Dockerfile.k8s --target worker -t adcs-worker .

# ---------------------------------------------------------------------------
# Stage 1: Python dependency builder
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VENV_PATH=/opt/venv

WORKDIR /app

RUN python -m venv "${VENV_PATH}"
ENV PATH="${VENV_PATH}/bin:${PATH}"

COPY pyproject.toml constraints.txt README.md LICENSE ./
COPY src ./src

# Install against the hash-pinned closure so the image is reproducible: a bare
# `pip install .` would re-resolve every dependency to whatever is newest on PyPI
# at build time, and an untested major version could ship.
# Two steps, as in Dockerfile.api: once the constraints carry hashes pip refuses to
# install the project directory itself, so the pinned closure (which includes the
# `metrics` extra) goes in first with --require-hashes and the project follows with
# --no-deps.
RUN pip install --upgrade pip \
    && pip install --require-hashes -r constraints.txt \
    && pip install --no-deps .

# License texts of the bundled Python packages, redistributed with the image.
COPY scripts/licenses/python_third_party_notices.py /tmp/
RUN python /tmp/python_third_party_notices.py --output /opt/licenses/THIRD_PARTY_NOTICES.txt \
    && cp LICENSE /opt/licenses/LICENSE

# ---------------------------------------------------------------------------
# Stage 2: Common runtime base
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime-base

# Provenance. Pass GIT_REVISION and BUILD_DATE so an image traces back to a commit:
#   docker build --build-arg GIT_REVISION=$(git rev-parse HEAD) \
#                --build-arg BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) ...
# Inspect with: docker inspect -f '{index .Config.Labels "org.opencontainers.image.revision"}' IMAGE
ARG GIT_REVISION=unknown
ARG BUILD_DATE=unknown
ARG IMAGE_VERSION=unknown
LABEL org.opencontainers.image.title="adcs" \
      org.opencontainers.image.description="ADCS runtime base image (api and worker targets)." \
      org.opencontainers.image.source="https://github.com/aspose-mcp/aspose-context-engine" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VENV_PATH=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/app/src

RUN groupadd --system appuser \
    && useradd --system --gid appuser --create-home --home-dir /home/appuser appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/licenses /licenses
COPY src ./src
COPY config ./config
# The source registry accepts repositories that are registered but not cloned yet
# (materialization_state: lazy_registered) only when they appear in .gitmodules,
# which it reads from the workspace root (/app). Without it the API refuses to start
# unless every source directory exists.
COPY .gitmodules ./

RUN mkdir -p /app/artifacts/config-history /app/artifacts/semantic-review \
    && chown -R appuser:appuser /app

USER appuser

# ---------------------------------------------------------------------------
# Stage 3a: API server (lightweight — no source-repo dirs)
# ---------------------------------------------------------------------------
FROM runtime-base AS api

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3).status == 200 else 1)"]

CMD ["python", "-m", "uvicorn", "adcs.api.main:app", "--host", "0.0.0.0", "--port", "8080"]

# ---------------------------------------------------------------------------
# Stage 3b: Celery worker
# ---------------------------------------------------------------------------
FROM runtime-base AS worker

USER root
# Ingestion reads each documentation source's git revision, so the worker needs git.
# The sources are mounted from the host and owned by another user, hence safe.directory.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
  CMD ["python", "-c", "import sys; from adcs.worker.celery_app import celery_app; sys.exit(0 if celery_app.control.ping(timeout=5) else 1)"]

CMD ["python", "-m", "celery", "-A", "adcs.worker.celery_app:celery_app", "worker", "--loglevel=info"]
